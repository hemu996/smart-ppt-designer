{
  "system_name": "red-gold",
  "label": "国奖红金",
  "mode": "light",
  "usage": "面向政府路演、产业振兴、竞赛答辩、乡村振兴方案汇报；以深红为骨、金线为饰，稳重克制，适合正式评审场合",
  "colors": {
    "primary": "#9C2317",
    "secondary": "#7A1A12",
    "accent": "#C9A227",
    "background": "#FFFFFF",
    "text": "#2E2620",
    "text_light": "#7A6A5A"
  },
  "fonts": {
    "title": "微软雅黑",
    "body": "微软雅黑",
    "title_size": [
      36,
      44
    ],
    "section_size": [
      28,
      32
    ],
    "page_title_size": [
      20,
      24
    ],
    "module_size": [
      16,
      18
    ],
    "body_size": [
      12,
      14
    ],
    "caption_size": [
      10,
      11
    ],
    "metric_size": [
      36,
      60
    ]
  },
  "decorations": {
    "title_bar": "gold_rule",
    "card_border": "gold_frame",
    "section_divider": "seal_block"
  },
  "navigation": {
    "mode": "sidebar",
    "active_color": "#C9A227",
    "inactive_color": "#EADFC8",
    "text_active": "#2E2620",
    "text_inactive": "#7A6A5A"
  },
  "grid": {
    "columns": 12,
    "margin_cols": 1,
    "unit_cm": 0.3,
    "unit_in": 0.1181,
    "tolerance_in": 0.02,
    "content_x_in": 1.38,
    "content_w_in": 11.45
  },
  "icon_style": "solid",
  "transition": "fade",
  "layers": {
    "L1_background": 0,
    "L2_decoration": [
      10,
      19
    ],
    "L3_content": [
      20,
      29
    ],
    "L4_title": [
      30,
      39
    ],
    "notes": "构建脚本按 z_index 升序绘制；装饰层不得高于内容层（红线第 11 条）"
  },
  "image_style": "humanities",
  "chart_palette": [
    "#9C2317",
    "#C9A227",
    "#B5544A",
    "#E0C070",
    "#7A6A5A"
  ],
  "density": {
    "max_modules_per_page": 5,
    "max_bullets_per_module": 4
  },
  "notes": "金色（accent）只作线描、分隔线与关键数字着色（≤8% 面积）；封面与章节页用深红底 + 金色/白色标题，不上大面积浅色",
  "card_style": {
    "icon_slot": true,
    "title_strip": true,
    "fill_alpha": 92,
    "border": "hairline",
    "corner_index": true,
    "shadow": true,
    "note": "v9.0 卡片精致度：浅色系统卡片 = 近白/浅灰底（92%）+ 主题色细描边 + 左上角序号带 + 标题条 + 轻微投影"
  }
}
