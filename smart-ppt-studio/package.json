{
  "name": "@local/smart-ppt-studio",
  "version": "1.9.0",
  "type": "module",
  "description": "国赛/创赛级 PPT 设计台（DeepSeek Harness 侧边栏）：19 套视觉系统、29 条红线、13 步工作流、32 条命令、18 条动效、95 份模板清单；本地导入 .pptx 自动抽封面并生成结构速览。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./data/*.json": "./data/*.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "data/styles.json",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "screenshots.json",
    "icon-180.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hemu996/smart-ppt-designer.git",
    "directory": "smart-ppt-studio"
  },
  "license": "MIT",
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "ppt",
    "pptx",
    "presentation",
    "design-system"
  ],
  "homepage": "https://github.com/hemu996/smart-ppt-designer/tree/main/smart-ppt-studio"
}
