{
  "name": "@local/smart-ppt-studio",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "description": "PPT 设计台：smart-ppt-designer 9.0.8 侧边栏，19 套风格 / 28 条红线 / 13 步工作流 / 15 条动效 / 95 份模板；视觉焕新 + 收藏 + 发送到对话 + 模板封面预览（宿主按需读取，导入即出图）。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./data/*.json": "./data/*.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "data/styles.json",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}